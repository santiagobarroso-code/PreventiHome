<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.preventihome.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_patientHomeFragment"
            app:destination="@id/patientHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loginFragment_to_fisioHomeFragment"
            app:destination="@id/fisioHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loginFragment_to_adminFragment"
            app:destination="@id/adminFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"/>
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.preventihome.ui.auth.RegisterFragment"
        android:label="Registro">
        <action
            android:id="@+id/action_registerFragment_to_patientHomeFragment"
            app:destination="@id/patientHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/patientHomeFragment"
        android:name="com.example.preventihome.ui.patient.PatientHomeFragment"
        android:label="Home Paciente">
        <action
            android:id="@+id/action_patientHome_to_consultas"
            app:destination="@id/consultasPacienteFragment"/>
        <action
            android:id="@+id/action_patientHome_to_misCitas"
            app:destination="@id/misCitasFragment"/>
        <action
            android:id="@+id/action_patientHome_to_ejercicios"
            app:destination="@id/ejerciciosFragment"/>
        <action
            android:id="@+id/action_patientHome_to_historial"
            app:destination="@id/historialFragment"/>
        <action
            android:id="@+id/action_patientHome_to_perfil"
            app:destination="@id/perfilFragment"/>
        <action
            android:id="@+id/action_patientHome_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/perfilFisioFragment"
        android:name="com.example.preventihome.ui.physio.PerfilFisioFragment"
        android:label="Perfil Fisio">
        <action
            android:id="@+id/action_perfilFisio_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/fisioHomeFragment"
        android:name="com.example.preventihome.ui.physio.FisioHomeFragment"
        android:label="Home Fisio">
        <action
            android:id="@+id/action_fisioHome_to_perfilFisio"
            app:destination="@id/perfilFisioFragment"/>
        <action
            android:id="@+id/action_fisioHome_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_fisioHome_to_citasPendientes"
            app:destination="@id/citasFisioFragment"/>
        <action
            android:id="@+id/action_fisioHome_to_historialPaciente"
            app:destination="@id/historialFisioFragment"/>
    </fragment>

    <!-- Historial de consultas de un paciente visto por el fisio -->
    <fragment
        android:id="@+id/historialFisioFragment"
        android:name="com.example.preventihome.ui.physio.HistorialFisioFragment"
        android:label="Historial paciente">
        <argument android:name="pacienteId"     app:argType="string"/>
        <argument android:name="pacienteNombre" app:argType="string"/>
        <argument android:name="pacienteEmail"  app:argType="string"/>
        <action
            android:id="@+id/action_historialFisio_to_detalleConsultaFisio"
            app:destination="@id/detalleConsultaFisioFragment"/>
        <action
            android:id="@+id/action_historialFisio_to_crearConsulta"
            app:destination="@id/crearConsultaFragment"/>
    </fragment>

    <!-- Detalle de consulta editable por el fisio -->
    <fragment
        android:id="@+id/detalleConsultaFisioFragment"
        android:name="com.example.preventihome.ui.physio.DetalleConsultaFisioFragment"
        android:label="Detalle consulta">
        <argument android:name="consultaId"     app:argType="string"/>
        <argument android:name="pacienteId"     app:argType="string"/>
        <argument android:name="pacienteNombre" app:argType="string"/>
        <argument android:name="pacienteEmail"  app:argType="string"/>
    </fragment>

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.example.preventihome.ui.admin.AdminFragment"
        android:label="Administrador">
        <action
            android:id="@+id/action_admin_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/ejerciciosFragment"
        android:name="com.example.preventihome.ui.patient.EjerciciosFragment"
        android:label="Ejercicios">
        <action
            android:id="@+id/action_ejercicios_to_detalle"
            app:destination="@id/ejercicioDetalleFragment"/>
    </fragment>

    <fragment
        android:id="@+id/ejercicioDetalleFragment"
        android:name="com.example.preventihome.ui.patient.EjercicioDetalleFragment"
        android:label="Detalle">
        <argument android:name="ejercicioId" app:argType="string"/>
        <action
            android:id="@+id/action_detalle_to_evaluacion"
            app:destination="@id/evaluacionFragment"/>
    </fragment>

    <fragment
        android:id="@+id/evaluacionFragment"
        android:name="com.example.preventihome.ui.patient.EvaluacionFragment"
        android:label="Evaluación">
        <argument android:name="ejercicioId"     app:argType="string"/>
        <argument android:name="ejercicioNombre" app:argType="string"/>
        <argument android:name="ejercicioZona"   app:argType="string"/>
        <argument android:name="duracion"        app:argType="integer"/>
        <argument android:name="series"          app:argType="integer"/>
        <argument android:name="repeticiones"    app:argType="integer"/>
    </fragment>

    <fragment
        android:id="@+id/historialFragment"
        android:name="com.example.preventihome.ui.patient.HistorialFragment"
        android:label="Historial"/>

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.preventihome.ui.patient.PerfilFragment"
        android:label="Perfil">
        <action
            android:id="@+id/action_perfil_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- Consultas del paciente -->
    <fragment
        android:id="@+id/consultasPacienteFragment"
        android:name="com.example.preventihome.ui.patient.ConsultasPacienteFragment"
        android:label="Mis consultas">
        <action
            android:id="@+id/action_consultasPaciente_to_detalleConsulta"
            app:destination="@id/detalleConsultaFragment"/>
    </fragment>

    <!-- Detalle de consulta para el paciente -->
    <fragment
        android:id="@+id/detalleConsultaFragment"
        android:name="com.example.preventihome.ui.patient.DetalleConsultaFragment"
        android:label="Detalle consulta">
        <argument android:name="consultaId" app:argType="string"/>
    </fragment>

    <!-- Crear consulta — usado por el fisioterapeuta -->
    <fragment
        android:id="@+id/crearConsultaFragment"
        android:name="com.example.preventihome.ui.physio.CrearConsultaFragment"
        android:label="Nueva consulta">
        <argument android:name="pacienteId"     app:argType="string"/>
        <argument android:name="pacienteNombre" app:argType="string"/>
        <argument android:name="pacienteEmail"  app:argType="string"/>
        <argument android:name="citaId"         app:argType="string" android:defaultValue=""/>
    </fragment>

    <!-- Citas del paciente -->
    <fragment
        android:id="@+id/misCitasFragment"
        android:name="com.example.preventihome.ui.patient.MisCitasFragment"
        android:label="Mis citas">
        <action
            android:id="@+id/action_misCitas_to_agendarCita"
            app:destination="@id/agendarCitaFragment"/>
    </fragment>

    <!-- Formulario agendar cita -->
    <fragment
        android:id="@+id/agendarCitaFragment"
        android:name="com.example.preventihome.ui.patient.AgendarCitaFragment"
        android:label="Agendar cita"/>

    <!-- Citas pendientes del fisio -->
    <fragment
        android:id="@+id/citasFisioFragment"
        android:name="com.example.preventihome.ui.physio.CitasFisioFragment"
        android:label="Citas pendientes">
        <action
            android:id="@+id/action_citasFisio_to_crearConsulta"
            app:destination="@id/crearConsultaFragment"/>
    </fragment>

</navigation>